# Port the Express server listens on.
PORT=5000
# This means that automatically, to run the frontend, and communicate with the backend
# it has to connect to http://localhost:5000, which is the backend server. If you change this, you will also need to change the frontend's Vite config.

# Therefore, the frontend .env should contain the api url e.g
VITE_API_URL=http://localhost:5000

# Long, random string used to sign and verify JWTs. Required — the server
# will refuse to start without it. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# and paste in the backend .env
# Never commit the real value — this file only documents that it exists.
JWT_SECRET=


DATABASE_URL=postgresql://postgres.PROJECT_REF:YOUR_PASSWORD@YOUR_POOLER_HOST:5432/postgres
