# Copy to backend/.env and fill locally. Never commit .env.
NODE_ENV=development
PORT=5000
FRONTEND_URL=http://localhost:5173
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE
# Either set DATABASE_CA_CERT to the PEM value, or retain public cert at backend/certs/prod-ca-2021.crt
DATABASE_CA_CERT=
# Required by the legacy config import; removal needs a separate auth audit
JWT_SECRET=replace-with-a-long-random-development-secret
# Demo-only local registration. Never enabled in production.
ALLOW_PUBLIC_REGISTRATION=false
# SMTP values are required for sending verification/password emails:
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=
